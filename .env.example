# Copy to .env and adjust. All values are optional for local dev.

# Default is SQLite. For Postgres:
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/shortener

# Unset = in-process cache. For Redis:
# REDIS_URL=redis://localhost:6379/0

# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars

BASE_URL=http://localhost:8000
